{
  "name": "pengupool",
  "displayName": "PenguPool",
  "description": "Manage Claude Code and pi sessions with a shared tmux terminal, session tree, live map, and message log. Requires the PenguPool CLI.",
  "version": "0.9.1",
  "publisher": "nduwork",
  "license": "MIT",
  "homepage": "https://pengupool.nduwork.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/nduwork/pengupool"
  },
  "icon": "media/icon.png",
  "keywords": [
    "Claude Code",
    "pi",
    "tmux",
    "sessions",
    "agents"
  ],
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pengupool",
          "title": "PenguPool",
          "icon": "media/penguin.svg"
        }
      ]
    },
    "views": {
      "pengupool": [
        {
          "id": "pengupoolSessions",
          "name": "Claude Sessions",
          "type": "webview"
        },
        {
          "id": "pengupoolPiSessions",
          "name": "Pi Sessions",
          "type": "webview",
          "when": "pengupool.bothHarnesses"
        },
        {
          "id": "pengupoolHints",
          "name": "Shortcuts"
        }
      ]
    },
    "commands": [
      {
        "command": "pengupool.switch",
        "title": "Open / Focus Session",
        "category": "PenguPool"
      },
      {
        "command": "pengupool.reveal",
        "title": "Reveal Session Folder",
        "category": "PenguPool"
      },
      {
        "command": "pengupool.quickSwitch",
        "title": "Quick Switch Session…",
        "category": "PenguPool"
      },
      {
        "command": "pengupool.new",
        "title": "New Session",
        "icon": "$(add)",
        "category": "PenguPool"
      },
      {
        "command": "pengupool.add",
        "title": "Add Previous Session…",
        "icon": "$(history)",
        "category": "PenguPool"
      },
      {
        "command": "pengupool.resumePrevious",
        "title": "Resume Previous Sessions…",
        "icon": "$(run-all)",
        "category": "PenguPool"
      },
      {
        "command": "pengupool.group",
        "title": "Group Under…",
        "category": "PenguPool"
      },
      {
        "command": "pengupool.rename",
        "title": "Rename",
        "category": "PenguPool"
      },
      {
        "command": "pengupool.describe",
        "title": "Describe Role…",
        "category": "PenguPool"
      },
      {
        "command": "pengupool.close",
        "title": "Close",
        "category": "PenguPool"
      },
      {
        "command": "pengupool.compact",
        "title": "Compact (/compact)",
        "category": "PenguPool"
      },
      {
        "command": "pengupool.clear",
        "title": "Fresh Context (/clear)",
        "category": "PenguPool"
      },
      {
        "command": "pengupool.newChild",
        "title": "New Child Session…",
        "category": "PenguPool"
      },
      {
        "command": "pengupool.addChild",
        "title": "Add Previous Session as Child…",
        "category": "PenguPool"
      },
      {
        "command": "pengupool.copyPath",
        "title": "Copy Path",
        "category": "PenguPool"
      },
      {
        "command": "pengupool.groupPlan",
        "title": "Apply Regrouping",
        "icon": "$(list-unordered)",
        "category": "PenguPool"
      },
      {
        "command": "pengupool.restart",
        "title": "Restart & Resume",
        "category": "PenguPool"
      },
      {
        "command": "pengupool.showMap",
        "title": "Show Map",
        "icon": "$(type-hierarchy)",
        "category": "PenguPool"
      },
      {
        "command": "pengupool.showLog",
        "title": "Show Log",
        "icon": "$(output)",
        "category": "PenguPool"
      },
      {
        "command": "pengupool.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "PenguPool"
      },
      {
        "command": "pengupool.fold",
        "title": "Fold Group",
        "category": "PenguPool"
      },
      {
        "command": "pengupool.unfold",
        "title": "Unfold Group",
        "category": "PenguPool"
      },
      {
        "command": "pengupool.foldAll",
        "title": "Fold All Groups",
        "category": "PenguPool"
      },
      {
        "command": "pengupool.unfoldAll",
        "title": "Unfold All Groups",
        "category": "PenguPool"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pengupool.new",
          "when": "view == pengupoolSessions || view == pengupoolPiSessions",
          "group": "navigation@1"
        },
        {
          "command": "pengupool.add",
          "when": "view == pengupoolSessions || view == pengupoolPiSessions",
          "group": "navigation@2"
        },
        {
          "command": "pengupool.resumePrevious",
          "when": "view == pengupoolSessions || view == pengupoolPiSessions",
          "group": "navigation@3"
        },
        {
          "command": "pengupool.showMap",
          "when": "view == pengupoolSessions || view == pengupoolPiSessions",
          "group": "navigation@4"
        },
        {
          "command": "pengupool.showLog",
          "when": "view == pengupoolSessions || view == pengupoolPiSessions",
          "group": "navigation@5"
        },
        {
          "command": "pengupool.refresh",
          "when": "view == pengupoolSessions || view == pengupoolPiSessions",
          "group": "navigation@6"
        }
      ],
      "webview/editor/title": [
        {
          "command": "pengupool.groupPlan",
          "when": "webview == pengupoolMap && pengupool.groupPlanPending",
          "group": "navigation@1"
        }
      ],
      "webview/context": [
        {
          "command": "pengupool.fold",
          "when": "(webviewId == pengupoolSessions || webviewId == pengupoolPiSessions || webviewId == pengupoolMap) && webviewSection == session && foldable && !folded",
          "group": "0_fold@1"
        },
        {
          "command": "pengupool.unfold",
          "when": "(webviewId == pengupoolSessions || webviewId == pengupoolPiSessions || webviewId == pengupoolMap) && webviewSection == session && folded",
          "group": "0_fold@2"
        },
        {
          "command": "pengupool.newChild",
          "when": "(webviewId == pengupoolSessions || webviewId == pengupoolPiSessions || webviewId == pengupoolMap) && webviewSection == session",
          "group": "1_add@1"
        },
        {
          "command": "pengupool.addChild",
          "when": "(webviewId == pengupoolSessions || webviewId == pengupoolPiSessions || webviewId == pengupoolMap) && webviewSection == session",
          "group": "1_add@2"
        },
        {
          "command": "pengupool.resumePrevious",
          "when": "(webviewId == pengupoolSessions || webviewId == pengupoolPiSessions || webviewId == pengupoolMap) && webviewSection == session",
          "group": "1_add@3"
        },
        {
          "command": "pengupool.reveal",
          "when": "(webviewId == pengupoolSessions || webviewId == pengupoolPiSessions || webviewId == pengupoolMap) && webviewSection == session",
          "group": "2_folder@1"
        },
        {
          "command": "pengupool.copyPath",
          "when": "(webviewId == pengupoolSessions || webviewId == pengupoolPiSessions || webviewId == pengupoolMap) && webviewSection == session",
          "group": "2_folder@2"
        },
        {
          "command": "pengupool.compact",
          "when": "(webviewId == pengupoolSessions || webviewId == pengupoolPiSessions || webviewId == pengupoolMap) && webviewSection == session",
          "group": "3_context@1"
        },
        {
          "command": "pengupool.clear",
          "when": "(webviewId == pengupoolSessions || webviewId == pengupoolPiSessions || webviewId == pengupoolMap) && webviewSection == session",
          "group": "3_context@2"
        },
        {
          "command": "pengupool.restart",
          "when": "(webviewId == pengupoolSessions || webviewId == pengupoolPiSessions || webviewId == pengupoolMap) && webviewSection == session",
          "group": "3_context@3"
        },
        {
          "command": "pengupool.group",
          "when": "(webviewId == pengupoolSessions || webviewId == pengupoolPiSessions || webviewId == pengupoolMap) && webviewSection == session",
          "group": "4_place@1"
        },
        {
          "command": "pengupool.rename",
          "when": "(webviewId == pengupoolSessions || webviewId == pengupoolPiSessions || webviewId == pengupoolMap) && webviewSection == session",
          "group": "4_place@2"
        },
        {
          "command": "pengupool.describe",
          "when": "(webviewId == pengupoolSessions || webviewId == pengupoolPiSessions || webviewId == pengupoolMap) && webviewSection == session",
          "group": "4_place@3"
        },
        {
          "command": "pengupool.close",
          "when": "(webviewId == pengupoolSessions || webviewId == pengupoolPiSessions || webviewId == pengupoolMap) && webviewSection == session",
          "group": "9_close@1"
        },
        {
          "command": "pengupool.new",
          "when": "(webviewId == pengupoolSessions || webviewId == pengupoolPiSessions || webviewId == pengupoolMap) && webviewSection == pool",
          "group": "1_add@1"
        },
        {
          "command": "pengupool.add",
          "when": "(webviewId == pengupoolSessions || webviewId == pengupoolPiSessions || webviewId == pengupoolMap) && webviewSection == pool",
          "group": "1_add@2"
        },
        {
          "command": "pengupool.resumePrevious",
          "when": "(webviewId == pengupoolSessions || webviewId == pengupoolPiSessions || webviewId == pengupoolMap) && webviewSection == pool",
          "group": "1_add@3"
        },
        {
          "command": "pengupool.foldAll",
          "when": "(webviewId == pengupoolSessions || webviewId == pengupoolPiSessions || webviewId == pengupoolMap) && webviewSection == pool && map && pengupool.mapFold == open",
          "group": "0_fold@1"
        },
        {
          "command": "pengupool.unfoldAll",
          "when": "(webviewId == pengupoolSessions || webviewId == pengupoolPiSessions || webviewId == pengupoolMap) && webviewSection == pool && map && pengupool.mapFold == folded",
          "group": "0_fold@2"
        }
      ],
      "commandPalette": [
        {
          "command": "pengupool.fold",
          "when": "false"
        },
        {
          "command": "pengupool.unfold",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pengupool.new",
        "key": "n",
        "when": "focusedView == pengupoolSessions || focusedView == pengupoolPiSessions"
      },
      {
        "command": "pengupool.add",
        "key": "a",
        "when": "focusedView == pengupoolSessions || focusedView == pengupoolPiSessions"
      },
      {
        "command": "pengupool.group",
        "key": "g",
        "when": "focusedView == pengupoolSessions || focusedView == pengupoolPiSessions"
      },
      {
        "command": "pengupool.rename",
        "key": "r",
        "when": "focusedView == pengupoolSessions || focusedView == pengupoolPiSessions"
      },
      {
        "command": "pengupool.describe",
        "key": "d",
        "when": "focusedView == pengupoolSessions || focusedView == pengupoolPiSessions"
      },
      {
        "command": "pengupool.close",
        "key": "x",
        "when": "focusedView == pengupoolSessions || focusedView == pengupoolPiSessions"
      },
      {
        "command": "pengupool.compact",
        "key": "c",
        "when": "focusedView == pengupoolSessions || focusedView == pengupoolPiSessions"
      },
      {
        "command": "pengupool.clear",
        "key": "shift+c",
        "when": "focusedView == pengupoolSessions || focusedView == pengupoolPiSessions"
      },
      {
        "command": "pengupool.restart",
        "key": "shift+r",
        "when": "focusedView == pengupoolSessions || focusedView == pengupoolPiSessions"
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "shift+enter",
        "args": {
          "text": "\u001b\r"
        },
        "when": "terminalFocus && pengupool.claudeTerminal"
      }
    ],
    "configuration": {
      "title": "PenguPool",
      "properties": {
        "pengupool.command": {
          "type": "string",
          "default": "pengupool",
          "description": "Path to the pengupool CLI. `<command> serve` streams NDJSON; `<command> ctl …` runs mutations."
        },
        "pengupool.explorerFollow": {
          "type": "boolean",
          "default": true,
          "description": "Reveal the focused session's folder in the Explorer when this window already contains it. A folder outside this window's workspace is left alone: PenguPool never adds folders to your workspace."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "dagre": "^0.8.5",
    "typescript": "^5.4.0"
  }
}
