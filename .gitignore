.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.step-status/
.DS_Store
dist/

# Per-user pi session scaffold (agent settings + quiet-tools artifacts). The extension writes full
# read/bash/subagent output to .pi/quiet-tools/ before compacting it — that can hold credentials and
# must never be committed. Ignore the whole scaffold so a routine `git add -A` can't leak it.
.env
.pi/

# The editor's installed dependencies. extension/.gitignore already covers them for git, but the build
# backend reads only this root file, so without this line the source distribution shipped 5,130 of them
# (43 MB) with every release.
node_modules/
